# ---- Runtime ----
# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
# Set true when running behind a reverse proxy / load balancer so request IPs come from X-Forwarded-For.
TRUST_PROXY=false

# ---- Database ----
DATABASE_URL=postgres://hireflow:hireflow@localhost:5432/hireflow
DB_POOL_MAX=10
# Set true for managed Postgres that requires TLS (Neon, RDS, Supabase ...)
DB_SSL=false
# Supabase: DB_SSL=true. If the pooler certificate is not trusted by Node, download the Supabase CA and set
# NODE_EXTRA_CA_CERTS=/path/to/prod-ca-2021.crt (preferred) rather than turning verification off.
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Auth ----
# At least 32 random characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TTL_SECONDS=900
# Refresh token lifetime when "remember me" is ticked / not ticked
REFRESH_TTL_DAYS=30
REFRESH_TTL_SHORT_HOURS=12
# Secure cookies need https. Keep true everywhere except plain-http local development.
COOKIE_SECURE=false
COOKIE_DOMAIN=
PASSWORD_RESET_TTL_MINUTES=30
# Account lockout: after N wrong passwords the account is locked for M minutes
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
# Argon2id cost. Defaults follow the OWASP minimum (19 MiB, 2 passes).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# ---- HTTP hardening ----
# Comma separated list of browser origins allowed to call the API (no wildcard).
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT_BYTES=1048576
# Global requests per window per IP, and the stricter limit for /auth and public share endpoints
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Public base URL of the SPA (used in password reset emails) and of this API (used in unsubscribe links)
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
# Disable Swagger UI at /docs in production if you do not want it public
DOCS_ENABLED=true

# ---- First admin (seed script) ----
# The seed creates this admin only when no user exists with the email. Never commit a real password.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_PASSWORD=
# ---- Email ----
# console (logs the message, dev only) | smtp | graph
MAIL_PROVIDER=console
MAIL_FROM=HireFlow <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Microsoft Graph (stub: needs an Entra app registration with Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox that sends the mail (user principal name)
GRAPH_SENDER=

# ---- Broadcast queue ----
# Vercel / serverless: set WORKER_ENABLED=false and CRON_SECRET (32+ chars). Supabase pg_cron then calls
# POST /api/v1/cron/broadcast every minute (see supabase/02_cron_broadcast.sql). Unset = endpoint off.
CRON_SECRET=
# Run the sending worker inside the API process. Set false to run `node dist/worker.js` separately.
WORKER_ENABLED=true
WORKER_POLL_MS=5000
# Sending caps across ALL broadcasts together
BROADCAST_PER_MINUTE=30
BROADCAST_PER_DAY=1000
# Only send between these local hours (0-24) in BROADCAST_TZ. 0 and 24 = always.
BROADCAST_WINDOW_START_HOUR=0
BROADCAST_WINDOW_END_HOUR=24
BROADCAST_TZ=Asia/Jakarta
BROADCAST_MAX_ATTEMPTS=4
# Retry delay = base * 2^(attempt-1), capped at 6 hours
BROADCAST_BACKOFF_BASE_SECONDS=60
# A recipient stuck in "sending" longer than this after a crash is marked failed (never auto resent)
BROADCAST_STALE_SENDING_SECONDS=300
# Secret that signs one-click unsubscribe tokens. At least 32 characters.
UNSUBSCRIBE_SECRET=change-me-change-me-change-me-change-me
# Postal address and company line printed in the footer of every broadcast (legal requirement in many countries)
BROADCAST_FOOTER_ADDRESS=
