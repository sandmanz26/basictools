# Copy to .env.local for local development. Vite only exposes variables that start with VITE_.
# Nothing here is a secret: anything VITE_* is visible in the browser bundle.

# Demo build: seeded demo accounts, shared demo password, reset codes shown on screen.
# Leave unset (= on) while the app is a browser-only prototype. Set to "false" once accounts live on the server.
VITE_DEMO_MODE=true

# Base URL of the backend API once the SPA is migrated (see docs/FRONTEND_MIGRATION.md). Also add its origin to
# connect-src in vercel.json.
# VITE_API_URL=https://api.example.com
